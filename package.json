{
  "name": "fpl-dashboard",
  "version": "2.0.0",
  "description": "FPL League Dashboard \u2014 Next.js rewrite for the 26/27 season",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:tour": "node tests/tour/week-tour.mjs /tmp/fpl-tour-shots 390 844",
    "test:tour:guards": "node tests/tour/guards.mjs",
    "test:tour:planner": "node tests/tour/planner-tour.mjs /tmp/fpl-tour-shots-planner 390 844",
    "test:tour:losers": "node tests/tour/losers-tour.mjs /tmp/fpl-tour-shots-losers 390 844",
    "test:tour:saf": "node tests/tour/saf-tour.mjs /tmp/fpl-tour-shots-saf 390 844",
    "test:tour:motm": "node tests/tour/motm-tour.mjs /tmp/fpl-tour-shots-motm 390 844",
    "test:tour:hof": "node tests/tour/hof-tour.mjs /tmp/fpl-tour-shots-hof 390 844",
    "test:tour:earnings": "node tests/tour/earnings-tour.mjs /tmp/fpl-tour-shots-earnings 390 844"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "next": "^15.3.0",
    "nodemailer": "^6.9.8",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^6.4.14",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "playwright-core": "^1.61.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
