# FPL Dashboard Environment Variables
# Copy this file to .env and fill in your values

# =============================================================================
# REQUIRED FOR PRODUCTION
# =============================================================================

# Admin password for the admin panel (CHANGE THIS!)
ADMIN_PASSWORD=your-secure-password-here

# Upstash Redis credentials (for persistent storage)
UPSTASH_REDIS_REST_URL=https://your-redis-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-redis-token

# =============================================================================
# OPTIONAL
# =============================================================================

# Server port (default: 3001, Render sets this automatically)
# PORT=3001

# League ID — EMERGENCY OVERRIDE ONLY. The league id normally comes from the
# active season's entry in src/lib/season-config.ts.
# LEAGUE_ID=619028

# Current season — boot-time FALLBACK only (default: 2025-26). Once the admin
# "Start new season" action has run, the active season lives in Redis
# ('active-season') and wins over this value. Season-specific rules/prizes
# live in src/lib/season-config.ts, keyed by season id.
# CURRENT_SEASON=2025-26

# Preview allowlist (comma-separated FPL entry ids) — who can see features that
# are still marked preview in src/server/preview-access.ts. This is how a
# finished feature runs in production, against real data, before it's shared
# with the league. Which features are gated is decided in that file, not here,
# so releasing one never depends on clearing this variable. Unset means gated
# features are on in development and off in production. See the README section
# "Preview access" for the full recipe.
# PREVIEW_ENTRY_IDS=1234567
#
# PLANNER_PREVIEW_ENTRY_IDS is the old, planner-specific name for the same
# thing. Still read as a fallback; prefer PREVIEW_ENTRY_IDS.
# PLANNER_PREVIEW_ENTRY_IDS=1234567

# Email alerts for errors (optional)
# EMAIL_USER=your-email@gmail.com
# EMAIL_PASS=your-app-password
# ALERT_EMAIL=alerts@example.com

# =============================================================================
# SET BY DEPLOYMENT PLATFORM
# =============================================================================

# NODE_ENV is typically set by your deployment platform
# NODE_ENV=production
